# Deny by default. Only pinned build metadata, production C# and adapters enter context.
**
!global.json
!Directory.Build.props
!Directory.Packages.props
!src/
!src/Platform.Api/
!src/Platform.Api/Operations/
!src/Platform.Api/**/*.cs
!src/Platform.Api/*.csproj
!src/Platform.Api/packages.lock.json
!src/Platform.Infrastructure/
!src/Platform.Infrastructure/Configuration/
!src/Platform.Infrastructure/Observability/
!src/Platform.Infrastructure/Persistence/
!src/Platform.Infrastructure/Persistence/Migrations/
!src/Platform.Infrastructure/**/*.cs
!src/Platform.Infrastructure/*.csproj
!src/Platform.Infrastructure/packages.lock.json
!src/Platform.Migrator/
!src/Platform.Migrator/Local/
!src/Platform.Migrator/**/*.cs
!src/Platform.Migrator/*.csproj
!src/Platform.Migrator/packages.lock.json
!infra/
!infra/keycloak/
!infra/keycloak/crm-local-realm.json
!infra/compose/
!infra/compose/entrypoints/
!infra/compose/entrypoints/*.sh
**/bin/**
**/obj/**
**/secrets.json
**/appsettings.Local.json
**/.env*
**/.local/**
**/.git/**
**/.superpowers/**
