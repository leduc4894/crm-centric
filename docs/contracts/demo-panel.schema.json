{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "activityCount": {
      "type": "integer",
      "minimum": 0
    },
    "lastActivityAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "activityCount",
    "lastActivityAt"
  ]
}
