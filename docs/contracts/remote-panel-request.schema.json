{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contactRef"
  ],
  "properties": {
    "contactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "externalId"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,127}$"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
