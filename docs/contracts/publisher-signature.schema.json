{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publisher detached signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "keyId",
    "signature"
  ],
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
