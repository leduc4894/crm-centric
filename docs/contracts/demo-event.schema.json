{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo Activity CloudEvent",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "datacontenttype",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "type": {
      "const": "demo.activity.created.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "subject": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "externalEntityId",
        "activityKind"
      ],
      "properties": {
        "externalEntityId": {
          "type": "string"
        },
        "activityKind": {
          "type": "string"
        },
        "score": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
